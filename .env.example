# MyCloud environment variables (template)
#
# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit it.
#
# IMPORTANT: The values below reflect the project author's setup as a
# concrete reference. When you fork this project, replace VPS_HOST /
# VPS_IP / VPS_USER with your own server's details. The IPFS and Solana
# values are network-level and the same for everyone.

# --- VPS connection ---
# Replace with your own server when forking. Author's reference values shown.
VPS_HOST=srv825251.hstgr.cloud
VPS_IP=82.25.91.136
VPS_USER=root
VPS_SSH_KEY_PATH=~/.ssh/mycloud_vps_ed25519

# --- IPFS (Kubo) endpoints (96xx port block per docs/PORTS.md) ---
# These are localhost-bound on the VPS — the host port mapping is
# project-specific to avoid collisions with other stacks. Adjust if
# you change the docker-compose port mappings.
IPFS_API_URL=http://127.0.0.1:9600
IPFS_GATEWAY_URL=http://127.0.0.1:9601
IPFS_PUBLIC_GATEWAY=https://your-vps-hostname.example.com/ipfs

# --- ICP network ---
# `local` for the dfx replica; `ic` for mainnet.
DFX_NETWORK=local

# --- Solana (for future registry NFT verification) ---
# Default mainnet RPC. Consider a paid endpoint (Helius/Triton) for
# production use to avoid rate limits.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta

# --- Polygon / EVM (optional, for OwnershipProof::EthereumNft) ---
# Uncomment + populate when wiring HTTP outcalls for EVM verification.
# POLYGON_RPC_URL=https://polygon-rpc.com
# ETHEREUM_RPC_URL=https://cloudflare-eth.com
